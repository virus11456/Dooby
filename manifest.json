{
  "manifest_version": 3,
  "name": "__MSG_ext_name__",
  "version": "1.6.0",
  "description": "__MSG_ext_description__",
  "default_locale": "en",
  "key": "",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "identity"
  ],
  "chrome_url_overrides": {
    "newtab": "pages/newtab.html"
  },
  "background": {
    "service_worker": "js/background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Dooby - Save current tab"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
